# ============================================
# ALT — Environment Configuration Template
# Copy to .env and fill in real values for production.
# Never commit the real .env file.
# ============================================

# General
ALT_ENV=production
ALT_DEBUG=false
ALT_SECRET_KEY=change-me-to-a-long-random-string

# Database (defaults to local SQLite if unset)
# ALT_DATABASE_URL=sqlite:///database.db

# Session / Security
ALT_SESSION_TIMEOUT_MIN=60
ALT_MAX_FAILED_LOGINS=5
ALT_LOCKOUT_MIN=15
ALT_BCRYPT_ROUNDS=12

# AI Translation
ALT_PRIMARY_MODEL=facebook/nllb-200-distilled-600M
ALT_MAX_TRANSLATION_CHARS=5000
ALT_TRANSLATION_TIMEOUT=30
ALT_FORCE_CPU=false

# Uploads
ALT_MAX_UPLOAD_MB=20

# Logging
ALT_LOG_LEVEL=INFO
